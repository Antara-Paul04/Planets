# ---- Supabase (server-side; free plan) ----
# Project URL and keys from: Supabase dashboard -> Project Settings -> API
SUPABASE_URL=
# anon key: safe for public use; currently only referenced server-side
SUPABASE_ANON_KEY=
# service-role key: SERVER ONLY. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Secret salt for HMAC-hashing reporter IPs (any long random string).
# Falls back to the service-role key when unset.
REPORT_IP_SALT=

# Optional: report threshold override (default 3)
# REPORT_THRESHOLD=3

# ---- report notifications (the project owner hears about every report) ----
# A Discord or Slack incoming webhook URL. Each report posts the planet, the
# reason, the distinct-network count, and signed one-click hide/restore links.
REPORT_WEBHOOK_URL=
# And/or email through Resend (https://resend.com): the API key, who to notify,
# and (optional) a verified sender. Without a verified domain, Resend's
# onboarding sender only delivers to the account's own address.
RESEND_API_KEY=
REPORT_NOTIFY_EMAIL=
# REPORT_FROM_EMAIL="ASTRAY reports <reports@yourdomain>"
# Signs the one-click moderation links (any long random string). Falls back to
# the service-role key when unset.
MODERATION_SECRET=
