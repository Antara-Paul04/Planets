# ---- moderation providers (server-side only; NEVER exposed to the browser) ----

# Required for live moderation: image + text moderation and vision OCR fallback
OPENAI_API_KEY=

# Optional: classic handwriting OCR via Google Cloud Vision
# (when unset, OpenAI vision transcription covers OCR)
GOOGLE_CLOUD_VISION_API_KEY=

# Optional: durable moderation records + reports (PostgREST/Supabase)
# Service-role key is server-side only. See lib/moderation/store.js for schema.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- decision thresholds (defaults shown; all optional) ----
# MOD_IMAGE_REJECT=0.7
# MOD_IMAGE_REVIEW=0.4
# MOD_TEXT_REJECT=0.8
# MOD_TEXT_REVIEW=0.5

# ---- rate limits / payload caps (defaults shown) ----
# MOD_RATE_PER_MINUTE=5
# MOD_RATE_PER_HOUR=30
# MOD_MAX_IMAGE_BYTES=2097152

# ---- development ----
# Deterministic stub providers, no credentials needed (never set in production)
# MODERATION_MOCK=1
# Client behavior: auto (default) | required | off
# VITE_MODERATION=auto
